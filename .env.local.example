# Copy this file to .env.local and fill in your real values.

# Formspree form ID — sign up at https://formspree.io, create a form,
# and paste the form ID (the part after /f/ in your endpoint URL).
# A default is hardcoded in src/components/ContactForm.tsx so the form
# works out of the box; this env var lets you override it per-environment
# (e.g. a different form for staging vs. production).
NEXT_PUBLIC_FORMSPREE_ID=mdayvqar
